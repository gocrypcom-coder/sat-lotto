# sat-lotto/.env.example

# --------------------------
# 1. BITCOIN & GREENLIGHT NETZWERK
# --------------------------
# Definiert das Greenlight-Netzwerk. Empfehlung: testnet
BITCOIN_NETWORK=testnet 

# WICHTIG: Ihr 12/24-Wörter Seed von Greenlight. MUSS SICHER VERWAHRT WERDEN.
GREENLIGHT_MNEMONIC="ihr seed hier sicher einfügen"
# WICHTIG: Ihre Node ID (Pubkey) von Greenlight (als Hex-String).
NODE_ID="ihr_greenlight_pubkey_hier_einfuegen" 

# --------------------------
# 2. DATENBANK (PostgreSQL)
# --------------------------
POSTGRES_USER=satlotto_user
POSTGRES_PASSWORD=EIN_SEHR_SICHERES_PASSWORT_HIER_EINFUEGEN
POSTGRES_DB=satlotto_db
DATABASE_URL=postgres://satlotto_user:EIN_SEHR_SICHERES_PASSWORT_HIER_EINFUEGEN@postgres:5432/satlotto_db

# --------------------------
# 3. NOSTR
# --------------------------
# Ihr öffentlicher Nostr-Schlüssel für Commitments (muss im Code als Umgebungsvariable gesetzt werden, der private Key als Secret)
NOSTR_PUBKEY=dein_nostr_pubkey_hier_einfuegen
